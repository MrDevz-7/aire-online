# Cadena de conexión a Postgres. Formato:
# postgresql+psycopg2://<usuario>:<password>@<host>:<puerto>/<nombre_db>
# Si usas el docker-compose.yml de la RAIZ del repo, estos valores ya calzan.
DATABASE_URL=postgresql+psycopg2://aire_online:aire_online_dev@localhost:5432/aire_online

# OpenAQ (gratis, sin tarjeta). Registrate en https://explore.openaq.org/register
# y copiá tu clave desde https://explore.openaq.org/account
# Sin comillas y sin espacios alrededor del "=".
OPENAQ_API_KEY=""

AQICN_TOKEN=""

# ---------------------------------------------------------------------------
# Gemini (Google AI Studio, gratis, sin tarjeta).
# https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# Una o más API keys separadas por coma. El código las rota: si una falla
# con 401/403 o agota su cuota, pasa a la siguiente. Sin claves, el sistema
# funciona igual usando la plantilla determinística (no llama a Gemini).
GEMINI_API_KEYS=""

# Modelo principal. Default verificado con la clave real en el Bloque 2
# de M6: gemini-3.8-flash responde bien en el nivel gratuito.
GEMINI_MODEL=gemini-3.8-flash

# Modelos de reserva, separados por coma. Se prueban en orden si el
# principal no está disponible para la clave.
GEMINI_MODELOS_FALLBACK=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Tope diario de SOLICITUDES HTTP a Gemini, en hora local de Colombia.
# Cuenta tanto los exitosos como los que fallan (429, timeout, validación).
# Si se alcanza, se usa la plantilla sin llamar a Gemini.
GEMINI_MAX_LLAMADAS_DIA=10

# Máximo de solicitudes HTTP por reporte (reintento + cascada incluidos).
GEMINI_MAX_INTENTOS_POR_REPORTE=3

# Timeout HTTP para una llamada a Gemini, en segundos.
GEMINI_TIMEOUT_S=60

# Mínimo de días objetivo DISTINTOS con auditorías calculadas para
# publicar un promedio de error (D70). Con menos días, el reporte dice
# "todavía no hay suficientes días auditados" y no publica cifras.
MIN_DIAS_AUDITADOS_PARA_PROMEDIO=3

# Largo máximo del texto narrativo del reporte (caracteres).
REPORTE_MAX_CARACTERES_TEXTO=4000

# development | production
ENVIRONMENT=development