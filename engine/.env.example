# Cadena de conexión a Postgres.
DATABASE_URL=postgresql+psycopg2://aire_online:aire_online_dev@localhost:5432/aire_online

# OpenAQ (gratis, sin tarjeta). https://explore.openaq.org/register
OPENAQ_API_KEY=""

# AQICN / WAQI. https://aqicn.org/data-platform/token/
AQICN_TOKEN=""

# ---------------------------------------------------------------------------
# Gemini (Google AI Studio, gratis, sin tarjeta).
# https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# Una o más keys separadas por coma. El cliente las rota ante 401/403,
# 429 y 503 antes de pasar al siguiente modelo.
GEMINI_API_KEYS=""

GEMINI_MODEL=gemini-3.8-flash

# Modelos de reserva, separados por coma.
GEMINI_MODELOS_FALLBACK=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Tope diario de solicitudes HTTP a Gemini (día local Colombia).
GEMINI_MAX_LLAMADAS_DIA=30

# Tope de solicitudes HTTP por reporte (rotaciones y reintentos incluidos).
GEMINI_MAX_INTENTOS_POR_REPORTE=40

GEMINI_TIMEOUT_S=60

# Días objetivo distintos para publicar un promedio de error (D70).
MIN_DIAS_AUDITADOS_PARA_PROMEDIO=3

# Largo máximo del texto narrativo del reporte.
REPORTE_MAX_CARACTERES_TEXTO=4000

# development | production
ENVIRONMENT=development