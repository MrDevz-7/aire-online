# Cadena de conexión a Postgres.
DATABASE_URL=postgresql+psycopg2://aire_online:aire_online_dev@localhost:5432/aire_online

# OpenAQ (gratis, sin tarjeta). https://explore.openaq.org/register
OPENAQ_API_KEY=""

# AQICN / WAQI. https://aqicn.org/data-platform/token/
AQICN_TOKEN=""

# ---------------------------------------------------------------------------
# Gemini (Google AI Studio, gratis, sin tarjeta).
# https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# Una o más keys separadas por coma. El cliente las rota ante 401/403,
# 429 y 503 antes de pasar al siguiente modelo.
GEMINI_API_KEYS=""

GEMINI_MODEL=gemini-3.8-flash

# Modelos de reserva, separados por coma.
GEMINI_MODELOS_FALLBACK=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Tope diario de solicitudes HTTP a Gemini (día local Colombia).
GEMINI_MAX_LLAMADAS_DIA=30

# Tope de solicitudes HTTP por reporte (rotaciones y reintentos incluidos).
GEMINI_MAX_INTENTOS_POR_REPORTE=40

GEMINI_TIMEOUT_S=60

# Días objetivo distintos para publicar un promedio de error (D70).
MIN_DIAS_AUDITADOS_PARA_PROMEDIO=3

# Largo máximo del texto narrativo del reporte.
REPORTE_MAX_CARACTERES_TEXTO=4000

# D74: fuentes cuyo histórico NO se expone público en
# /api/estaciones/{id}/lecturas (lista separada por comas; ej. "aqicn").
# Vacío = historial completo para todas las fuentes. Para esas fuentes el
# endpoint devuelve solo el último snapshot (una lectura por contaminante)
# y marca historico_restringido: true.
FUENTES_SIN_HISTORICO_PUBLICO=

# ---------------------------------------------------------------------------
# M8: autenticación y secreto servicio-a-servicio (D77, D79).
# ---------------------------------------------------------------------------
# Secreto compartido entre engine y gateway. El gateway lo envía en la
# cabecera X-Internal-Token en cada llamada a /internal/*. Si está vacío,
# las rutas /internal/* quedan abiertas (solo desarrollo local: D44
# intacto). En producción (ENVIRONMENT=production) el engine NO arranca
# sin esto.
# Generar uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
INTERNAL_API_TOKEN=

# development | production
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# M10: scheduler y purgas (D87-D91).
# ---------------------------------------------------------------------------
# Interruptor maestro del scheduler embebido (D87). En tests o al hacer
# debugging, ponerlo en false para que el reloj real no dispare scraping
# ni purgas.
SCHEDULER_ENABLED=true

# Retención de lecturas detalladas, en días (D90). Auditorías y
# comparaciones agregadas se conservan siempre (D15).
RETENCION_LECTURAS_DIAS=60

# Período de gracia antes de borrar una sesión de refresh revocada, en
# horas (D91). Las sesiones VENCIDAS se borran de inmediato.
RETENCION_SESIONES_REVOCADAS_HORAS=24

# D66: mínimo de horas distintas del día local con al menos una lectura
# real, para que el día cuente como completo en la auditoría. Antes era
# una constante hardcodeada en services/auditoria.py; M10 la migra acá.
# Default: 16 (~2/3 del día).
MIN_HORAS_CON_LECTURA_AUDITORIA=16