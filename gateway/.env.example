# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto en el que escucha el gateway
PORT=4000

# Orígenes del frontend permitidos por CORS, separados por coma y sin
# barra final. En production es obligatorio. En development, si falta,
# se usa http://localhost:3000.
CORS_ORIGINS=http://localhost:3000

# URL base del engine (FastAPI), sin barra final.
# - Local con venv:    http://localhost:8000
# - Docker Compose:    http://engine:8000   (el nombre del servicio en la red)
ENGINE_URL=http://localhost:8000

# Timeout del cliente HTTP del engine, en milisegundos (rango: 100-60000).
# Si el engine tarda más que esto en responder, el gateway corta y devuelve
# 504 ENGINE_TIMEOUT. Un segundo intento NO se hace para timeouts.
ENGINE_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# M8: autenticación (D77, D78, D79).
# ---------------------------------------------------------------------------
# Secreto servicio-a-servicio. DEBE ser el MISMO valor que el
# INTERNAL_API_TOKEN de engine/.env: el gateway lo envía en la cabecera
# X-Internal-Token en cada llamada a /internal/*, y el engine lo exige.
# Si los dos valores no coinciden, TODAS las llamadas /internal/* devuelven
# 401 y el login no funciona.
# Generar uno nuevo con (en PowerShell):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
INTERNAL_API_TOKEN=

# Secreto para firmar los JWT de acceso (HS256). Mínimo 32 bytes (256 bits).
# El gateway SE NIEGA A ARRANCAR si falta o es más corto (D78).
# Generar uno nuevo con (en PowerShell):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Vida del access token, en segundos. Default: 15 minutos.
JWT_ACCESS_TTL_S=900

# Vida del refresh token, en segundos. Default: 7 días.
REFRESH_TTL_S=604800

# SameSite de la cookie de refresco: lax | strict | none.
# Default: lax. En desarrollo (frontend y gateway en localhost) `lax`
# alcanza. Si en producción el frontend y el gateway están en dominios
# distintos, hace falta `none` + `Secure` (solo HTTPS).
COOKIE_SAMESITE=lax

# Timeout para las llamadas al proxy administrativo (/api/admin/*), en
# milisegundos. Es más largo que ENGINE_TIMEOUT_MS porque ingesta y
# captura de pronósticos pueden tardar. Default: 120000 (2 min).
ADMIN_TIMEOUT_MS=120000